# Блок для Caddyfile существующего прокси. Добавить в конец файла,
# заменив meeto.example.com на свой домен.
#
# Caddy сам получит сертификат Let's Encrypt при первом обращении
# и будет продлевать его автоматически — certbot не нужен.

meeto.example.com {
	encode zstd gzip

	# Поток живых обновлений: ответ не завершается, поэтому буферизацию
	# снимаем, а ожидание чтения делаем долгим — тишина здесь норма.
	handle /api/v1/stream {
		reverse_proxy meeto-api:8000 {
			flush_interval -1
			transport http {
				read_timeout 1h
			}
		}
	}

	# API бэкенда: пути уже начинаются с /api/v1, переписывать не нужно
	handle /api/* {
		reverse_proxy meeto-api:8000
	}

	# всё остальное — статика mini-app
	handle {
		reverse_proxy meeto-miniapp:80
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	request_body {
		max_size 20MB
	}
}
