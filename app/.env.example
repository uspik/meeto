# ============ Telegram ============
# Токен от @BotFather
BOT_TOKEN=123456789:AAErs-your-token-here
# Имя бота без @ — из него собираются ссылки-приглашения
BOT_USERNAME=MeetoBot

# ============ Домен ============
# Только домен, без https:// и без слеша
DOMAIN=meeto.example.com
# Полный адрес — используется в CORS и в кнопке «Открыть Meeto»
PUBLIC_URL=https://meeto.example.com
# Почта для Let's Encrypt: туда придёт письмо, если сертификат не продлится
LETSENCRYPT_EMAIL=you@example.com

# ============ Безопасность ============
# Сгенерировать: openssl rand -base64 48
JWT_SECRET=ОБЯЗАТЕЛЬНО-ЗАМЕНИТЬ
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30
INITDATA_TTL=86400

# ============ База и кэш ============
POSTGRES_USER=meeto
# Сгенерировать: openssl rand -base64 24
POSTGRES_PASSWORD=ОБЯЗАТЕЛЬНО-ЗАМЕНИТЬ
POSTGRES_DB=meeto
# Пароль здесь должен совпадать с POSTGRES_PASSWORD выше
DATABASE_URL=postgresql+asyncpg://meeto:ОБЯЗАТЕЛЬНО-ЗАМЕНИТЬ@db:5432/meeto
REDIS_URL=redis://redis:6379/0

# ============ Отладка ============
# Вход в mini-app из обычного браузера, без Telegram: /?dev=<токен>
# Пустое значение полностью выключает ручку. Оставлять надолго не стоит.
# Сгенерировать: openssl rand -hex 16
DEV_LOGIN_TOKEN=

# ============ Прочее ============
DEFAULT_TZ=Europe/Moscow
LOG_LEVEL=INFO
