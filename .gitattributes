# Нормализуем переводы строк: в репозитории всегда LF.
* text=auto eol=lf

# Критично: вы работаете в Windows, а разворачиваете на Linux.
# Если shell-скрипт попадёт на сервер с CRLF, bash ответит
# "bad interpreter: /usr/bin/env bash^M" и ничего не запустится.
*.sh        text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.conf      text eol=lf
*.template  text eol=lf

# Батники, наоборот, должны остаться с CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Бинарники не трогаем
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
*.gz binary

# В diff'ах эти файлы только шумят
package-lock.json  -diff linguist-generated
